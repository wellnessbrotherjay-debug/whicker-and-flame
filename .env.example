# Local development (copy to .env)
PORT=4317
PUBLIC_ORIGIN=http://localhost:4317
DATABASE_URL=postgres://localhost/whisker_dev
# Comma-separated emails that may use the video studio at /studio
ADMIN_EMAILS=
# Random shared token for the n8n video workflow (HTTP header auth)
WF_WORKFLOW_TOKEN=

# Server (.env.production next to compose.yml)
# DOMAIN=whiskerandheat.com
# POSTGRES_PASSWORD=<long random value>
# ADMIN_EMAILS=
# WF_WORKFLOW_TOKEN=
