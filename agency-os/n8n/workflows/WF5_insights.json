        720,
        300
      ],
      "parameters": {
        "jsCode": "function aiText(r) {\n  if (r.status !== 'completed') throw new Error('OpenAI response not completed: ' + (r.status ?? 'error'));\n  const text = (r.output ?? []).flatMap(o => o.content ?? []).filter(b => b.type === 'output_text').map(b => b.text).join('').trim();\n  if (!text) throw new Error('OpenAI response contains no output text');\n  return text;\n}\nreturn ($json.due ?? []).map(d => ({ json: d }));"
      }
    },
    {
      "id": "92fe420f-8b46-4766-b367-46ed738d5085",
      "name": "Fetch insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/{{ $(\"Config\").first().json.graph_version }}/{{ $json.ig_media_id }}/insights",
        "options": {
          "timeout": 60000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "metric",
              "value": "={{ $json.format === \"reel\" ? \"reach,likes,comments,saved,shares,views,ig_reels_avg_watch_time\" : \"reach,likes,comments,saved,shares,views,profile_visits,follows\" }}"
            }
          ]
        }
      },
      "credentials": {
        "facebookGraphApi": {
          "id": "wos-instagram-whisker",
          "name": "Whisker & Heat Instagram Page"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "96a92b54-c5c0-45d4-81ce-570b55c2d987",
      "name": "Normalise metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "function aiText(r) {\n  if (r.status !== 'completed') throw new Error('OpenAI response not completed: ' + (r.status ?? 'error'));\n  const text = (r.output ?? []).flatMap(o => o.content ?? []).filter(b => b.type === 'output_text').map(b => b.text).join('').trim();\n  if (!text) throw new Error('OpenAI response contains no output text');\n  return text;\n}\n\nconst due = $('Split due').all();\nreturn $input.all().map((item, idx) => {\n  const src = due[idx].json;\n  const data = item.json.data ?? [];\n  const v = (name) => { const m = data.find(d => d.name === name); return m ? Number(m.values?.[0]?.value ?? m.total_value?.value ?? 0) : null; };\n  return { json: { post_id: src.post_id, hours: src.hours, ok: data.length > 0,\n    error: item.json.error ? String(item.json.error.message ?? item.json.error).slice(0, 300) : null,\n    views: v('views'), reach: v('reach'), likes: v('likes'), saves: v('saved'), shares: v('shares'),\n    comments: v('comments'), profile_visits: v('profile_visits'), follows: v('follows'),\n    avg_watch_ms: v('ig_reels_avg_watch_time') } };\n});"
      }
    },
