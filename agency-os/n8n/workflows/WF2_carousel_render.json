        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHOS_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: \"WF2_render\", runid: String($execution.id), status: \"ok\", message: String(\"job \" + $(\"Collapse to job\").first().json.job_id + \" -> \" + $json.result) }) }}"
      }
    },
    {
      "id": "c02b1466-b978-4cf8-849c-ee1151cf10f4",
      "name": "Collect render error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        520
      ],
      "parameters": {
        "jsCode": "function aiText(r) {\n  if (r.status !== 'completed') throw new Error('OpenAI response not completed: ' + (r.status ?? 'error'));\n  const text = (r.output ?? []).flatMap(o => o.content ?? []).filter(b => b.type === 'output_text').map(b => b.text).join('').trim();\n  if (!text) throw new Error('OpenAI response contains no output text');\n  return text;\n}\n\nconst e = $input.first().json;\nreturn [{ json: { job_id: $('Claim render job').first().json.job.job_id,\n  error: String(e.error?.message ?? e.message ?? JSON.stringify(e)).slice(0, 1000) } }];"
      },
      "executeOnce": true
    },
    {
      "id": "22befbed-2da6-43c8-b342-981468d894bd",
      "name": "Finish job (failed)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        520
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHOS_API_URL }}/empire/agencyos/AgencyOSService/FinishRenderJob",
        "options": {
