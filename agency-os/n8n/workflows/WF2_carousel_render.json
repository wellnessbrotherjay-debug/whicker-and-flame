              "name": "Authorization",
              "value": "=Bearer {{ $env.WHOS_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job: $json.job_id, ok: true }) }}"
      }
    },
    {
      "id": "72a78ed2-c47a-45bd-9255-90eefd58cb13",
      "name": "Log run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        300
