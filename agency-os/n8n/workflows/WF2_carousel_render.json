    {
      "id": "5f51e39b-e7e2-4f76-8a14-18786e6e6bae",
      "name": "Job claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "86c43ae8-345e-4785-aa36-e57e6dfaf2eb",
              "leftValue": "={{ !!$json.job }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "41a78396-6ed8-4df9-a03f-df102ce8da95",
      "name": "Plan slide renders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "function aiText(r) {\n  if (r.status !== 'completed') throw new Error('OpenAI response not completed: ' + (r.status ?? 'error'));\n  const text = (r.output ?? []).flatMap(o => o.content ?? []).filter(b => b.type === 'output_text').map(b => b.text).join('').trim();\n  if (!text) throw new Error('OpenAI response contains no output text');\n  return text;\n}\n\nconst cfg = $('Config').first().json;\nconst job = $('Claim render job').first().json.job;\n// The renderer draws slide 0 as the hook cover, then one image per slide.\nconst slides = Array.isArray(job.slides) ? job.slides : [];\nconst total = job.format === 'single' ? 1 : slides.length + 1;\nif (total > 10) throw new Error(`Post ${job.post_id} would be ${total} images; Instagram max is 10`);\nreturn Array.from({ length: total }, (_, n) => ({ json: { job_id: job.job_id, post_id: job.post_id, position: n, brand_version: job.brand_version ?? 1 } }));"
      }
    },
    {
      "id": "3f21e611-d95d-4650-adf9-f2a0adf292d3",
      "name": "Render and store slide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHOS_RENDER_URL }}/render?post={{ $json.post_id }}&slide={{ $json.position }}&v={{ $json.brand_version }}",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHOS_API_TOKEN }}"
            }
          ]
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "0b84649c-8c9c-45f6-9df8-9c7c5c2977d1",
      "name": "Collapse to job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "function aiText(r) {\n  if (r.status !== 'completed') throw new Error('OpenAI response not completed: ' + (r.status ?? 'error'));\n  const text = (r.output ?? []).flatMap(o => o.content ?? []).filter(b => b.type === 'output_text').map(b => b.text).join('').trim();\n  if (!text) throw new Error('OpenAI response contains no output text');\n  return text;\n}\nreturn [{ json: { job_id: $('Plan slide renders').first().json.job_id, slides: $input.all().length } }];"
      }
    },
    {
      "id": "7da02be3-fda9-4e24-8221-193ebef72160",
      "name": "Finish job (ok)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
