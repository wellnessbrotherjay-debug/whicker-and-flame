    {
      "id": "8bcee28a-fc27-4cc4-bec7-a6bc8bb450a3",
      "name": "Format alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "function aiText(r) {\n  if (r.status !== 'completed') throw new Error('OpenAI response not completed: ' + (r.status ?? 'error'));\n  const text = (r.output ?? []).flatMap(o => o.content ?? []).filter(b => b.type === 'output_text').map(b => b.text).join('').trim();\n  if (!text) throw new Error('OpenAI response contains no output text');\n  return text;\n}\n\nconst e = $('Error Trigger').first().json;\nconst wfName = e.workflow?.name ?? 'unknown workflow';\nconst node = e.execution?.lastNodeExecuted ?? 'unknown node';\nconst msg = (e.execution?.error?.message ?? 'no message').slice(0, 500);\nconst url = e.execution?.url ?? '';\nreturn [{ json: {\n  workflow: wfName, node, message: msg, run_id: String(e.execution?.id ?? ''),\n  text: `\ud83d\udea8 Agency OS error\\nWorkflow: ${wfName}\\nNode: ${node}\\nError: ${msg}\\n${url}`\n}}];"
      }
    },
    {
      "id": "b3732912-39c9-4cec-b0e9-b26eb03a6d72",
      "name": "Log error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHOS_API_URL }}/empire/agencyos/AgencyOSService/LogWorkflow",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHOS_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow, runid: $json.run_id, status: \"error\", message: $json.message, payload: JSON.stringify({ node: $json.node }) }) }}"
      }
    },
    {
      "id": "97685f12-00f7-4a8e-a2a6-51b00863bbbe",
      "name": "WhatsApp alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $(\"Config\").first().json.graph_version }}/{{ ($env.AOS_WA_PHONE_NUMBER_ID || $env.MAGNOVENT_WA_PHONE_NUMBER_ID) }}/messages",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ ($env.AOS_WA_ACCESS_TOKEN || $env.MAGNOVENT_WA_ACCESS_TOKEN) }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: String(($env.AOS_OWNER_WHATSAPP || $env.MAGNOVENT_OWNER_WHATSAPP) ?? \"\").split(\",\")[0].replace(/\\D/g, \"\"), type: \"template\", template: { name: $(\"Config\").first().json.wa_notice_template, language: { code: $(\"Config\").first().json.wa_template_lang }, components: [{ type: \"body\", parameters: [{ type: \"text\", text: String($(\"Format alert\").first().json.text).replace(/\\s*\\n+\\s*/g, \" \u00b7 \").replace(/\\t/g, \" \").replace(/ {4,}/g, \"   \").slice(0, 900) }] }] } }) }}"
      }
    }
  ],
