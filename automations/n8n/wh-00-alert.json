      "parameters": {
        "jsCode": "const e = $json.execution || {};\nreturn [{json: {text: 'Whisker & Heat workflow failed: ' + ($json.workflow?.name || '?') + ' at ' + (e.lastNodeExecuted || '?') + ' — ' + (e.error?.message || 'no message') + ' ' + (e.url || '')}}];"
      }
    },
    {
      "id": "9b9a7484-e287-9fc9-2778-ddca30283c69",
      "name": "Only when an alert address is set",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "if (!$env.WH_ALERT_WEBHOOK) return []; return $input.all();"
      }
    },
    {
      "id": "52ee4036-42e0-9f19-2a97-df1fbffe02e6",
      "name": "Send alert",
      "type": "n8n-nodes-base.httpRequest",
